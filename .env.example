# URL base da API externa (opcional).
# Se não informada, a aplicação consome as rotas internas /api/* do Next.js.
NEXT_PUBLIC_API_URL=""

# URL privada no servidor para proxy de produtos/coleções de uma API externa (opcional).
STORE_API_URL=""

# Endpoint público para consulta automática de CEP no cadastro.
NEXT_PUBLIC_VIACEP_URL="https://viacep.com.br/ws"

# Valor mínimo de compra (em R$) para liberar frete grátis.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="299"

# Nome público exibido na loja.
NEXT_PUBLIC_STORE_NAME="Digital Store"
